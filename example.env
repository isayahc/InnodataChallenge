# Enter your Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Enter your OpenRouter API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Floorplan and question agents: anthropic or openrouter
TEXT_PROVIDER=anthropic
# Optional override; use the selected provider's model ID
# TEXT_MODEL=claude-haiku-4-5

# Images are rendered locally with resvg-js; no image-model key is needed.
# Image evaluation uses OpenRouter, independently for:
# anthropic/claude-opus-5.5 and openai/gpt-6-luna
OUTPUT_DIR=outputs
# Defaults to OUTPUT_DIR/history.sqlite
# DATABASE_PATH=outputs/history.sqlite
