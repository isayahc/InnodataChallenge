# Enter your Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Enter your OpenRouter API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Text and vision agents: anthropic or openrouter
TEXT_PROVIDER=anthropic
# Optional override; use the selected provider's model ID
# TEXT_MODEL=claude-haiku-4-5

# Image generation always uses OpenRouter
IMAGE_MODEL=bytedance-seed/seedream-4.5
OUTPUT_DIR=outputs
# Defaults to OUTPUT_DIR/history.sqlite
# DATABASE_PATH=outputs/history.sqlite
